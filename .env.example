# Required: OpenWeatherMap API key (One Call API 4.0 / One Call by Call subscription)
OPENWEATHER_API_KEY=your_api_key_here

# Server
PORT=3000
NODE_ENV=development

# Cache TTL in seconds (minimum 3600 = 1 hour; limits OpenWeatherMap calls)
CACHE_TTL_SECONDS=3600

# Redis (optional — falls back to in-memory cache if unset)
REDIS_URL=redis://localhost:6379

# Rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Pendo (optional — browser agent and server-side track events disabled if unset)
PENDO_API_KEY=your_pendo_api_key_here
PENDO_INTEGRATION_KEY=your_pendo_integration_key_here
